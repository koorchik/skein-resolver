# Copy to .env and fill in. NEVER commit .env — it is gitignored on purpose.
# Only the provider you actually run needs a real key.

# Google AI Studio — the cloud stack (gemini-3.7-flash judge, gemini-embedding-2 encoder)
GEMINI_API_KEY="CHANGE_ME"

# ollama.com — the open-weight stack served from the cloud (gemma4:31b with OLLAMA_CLOUD=1).
# A LOCAL ollama server (embeddinggemma, local gemma tags) needs no key at all.
OLLAMA_API_KEY="CHANGE_ME"

# --- defaults for interactive use ------------------------------------------
# CLI env vars override these, and every experiment arm sets them explicitly
# (see scripts/run-arm.sh and docs/REPRODUCE.md), so treat these as
# convenience only — never as the definition of an arm.
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.7-flash"
STEPS="streamingNormalizer"
EMBEDDINGS_PROVIDER="ollama"
EMBEDDINGS_MODEL="embeddinggemma"
